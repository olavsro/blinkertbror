# ---- Database ----
DATABASE_URL=postgres://qbikk:qbikk@localhost:5433/qbikk

# ---- Kryptering av tokens/innlogginger i ro (AES-256-GCM) ----
# Generer: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=CHANGE_ME_32_BYTES_BASE64

# ---- LLM-ekstraksjon ----
ANTHROPIC_API_KEY=sk-ant-...
EXTRACTION_MODEL=claude-opus-5

# ---- E-postinntak ----
# Domenet videresendingsadressene lever pa: <slug>@bilag.minapp.no
INBOUND_EMAIL_DOMAIN=bilag.minapp.no
# Delt hemmelighet som webhook-kallet ma signere/oppgi. Sett samme verdi i Mailgun/Postmark.
INBOUND_WEBHOOK_SECRET=dev-secret
# mailgun | postmark | mailhog
INBOUND_PROVIDER=mailhog
MAILHOG_API_URL=http://localhost:8025

# ---- Lagring av radokumenter ----
# local | s3
BLOB_DRIVER=local
BLOB_LOCAL_PATH=./storage/blobs

# ---- Bank (PSD2) ----
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=
GOCARDLESS_BASE_URL=https://bankaccountdata.gocardless.com/api/v2

# ---- App ----
APP_URL=http://localhost:3000
DEFAULT_PROFILE=dj
LOG_LEVEL=info
